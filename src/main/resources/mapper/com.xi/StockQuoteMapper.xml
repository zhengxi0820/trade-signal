<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xi.orm.mapper.StockQuoteMapper">

    <resultMap id="StockQuoteDOResultMap" type="com.xi.orm.entity.StockQuoteDO">
        <id column="ID" property="id"/>
        <result column="CODE" property="code"/>
        <result column="NAME" property="name"/>
        <result column="MARKET" property="market"/>
        <result column="OPEN" property="open"/>
        <result column="HIGH" property="high"/>
        <result column="LOW" property="low"/>
        <result column="CLOSE" property="close"/>
        <result column="VOLUME" property="volume"/>
        <result column="TRADE_DATE" property="tradeDate"/>
        <result column="ADJUST" property="adjust"/>
        <result column="CREATED_AT" property="createdAt"/>
        <result column="UPDATED_AT" property="updatedAt"/>
    </resultMap>

    <select id="queryAll" resultMap="StockQuoteDOResultMap">
        select * from stock_quote
        <where>
            <if test="code != null and code != ''">
                and code = #{code}
            </if>
            <if test="adjust != null and adjust != ''">
                and adjust = #{adjust}
            </if>
            <if test="tradeDate != null and tradeDate != ''">
                and trade_date = #{tradeDate}
            </if>
        </where>
        order by trade_date
    </select>

    <select id="queryDistinctCodes" resultType="java.lang.String">
        select distinct code from stock_quote
        <where>
            <if test="adjust != null and adjust != ''">
                and adjust = #{adjust}
            </if>
        </where>
        order by code
    </select>
</mapper>