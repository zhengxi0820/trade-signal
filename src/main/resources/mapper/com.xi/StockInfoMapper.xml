<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xi.orm.mapper.StockInfoMapper">

    <resultMap id="StockInfoDOResultMap" type="com.xi.orm.entity.StockInfoDO">
        <id column="ID" property="id"/>
        <result column="CODE" property="code"/>
        <result column="NAME" property="name"/>
        <result column="MARKET" property="market"/>
        <result column="BOARD_TYPE" property="boardType"/>
        <result column="CREATED_AT" property="createdAt"/>
        <result column="UPDATED_AT" property="updatedAt"/>
    </resultMap>

    <select id="queryAll" resultMap="StockInfoDOResultMap">
        select * from stock_info
    </select>

</mapper>
